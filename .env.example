# Variables réservées au serveur : ne pas utiliser NEXT_PUBLIC_ pour le mot de passe.
ADMIN_USERNAME=MOVIC
ADMIN_PASSWORD=
PROVENDERIE_DELETE_PASSWORD=change-me

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète Supabase : serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Domaines (facultatif : valeurs par défaut ci-dessous)
PUBLIC_SITE_URL=https://scoopslereveil.com
PUBLIC_SITE_HOSTS=scoopslereveil.com,www.scoopslereveil.com,localhost,127.0.0.1
APP_SITE_HOSTS=scoopslereveil.app,www.scoopslereveil.app,agroflux.localhost
